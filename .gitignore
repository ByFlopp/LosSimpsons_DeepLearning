# Claude Code
# Se versiona la configuración compartida del proyecto; nunca la local ni el estado.
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/skills

# Entorno y secretos
.env
.env.*
!.env.example

# Dataset (se descarga con scripts/descargar_dataset.py, no se versiona)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Artefactos de entrenamiento (se regeneran al ejecutar el notebook)
# Una carpeta por tipo de modelo (PMC/, CNN/) y dentro una subcarpeta por dataset
# (oldDataset/newDataset); solo se versionan sus .gitkeep
*/models/**
!*/models/*/
!*/models/*/.gitkeep
*/models_gpu/
*.keras
*.h5

# Jupyter
.ipynb_checkpoints/

# Dependencias
node_modules/
.pnpm-store/

# Build y caché
dist/
build/
out/
.next/
.astro/
.turbo/
.cache/
*.tsbuildinfo

# Cobertura y reportes
coverage/
.lighthouseci/

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Entorno virtual
.venv/
venv/
# Entorno GPU de Windows nativo: PyTorch ocupa varios GB
.venv-gpu/

